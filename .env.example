# Hosted persistence (Neon pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Authentication (Clerk dashboard → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Administrators: comma-separated Clerk user ids allowed to mint admin API keys
# and call /api/admin/* (editorial content, programme catalogue).
ADMIN_USER_IDS=user_...

# Local test user (development only). Runs the app against DATABASE_URL with no
# Clerk keys, with every request acting as this user, so the database-backed
# admin and editorial surfaces can be exercised locally. Point DATABASE_URL at a
# database branch, never production. Refuses to start under NODE_ENV=production,
# on Vercel, or alongside Clerk keys. See README "Local test user".
# WICKER_LOCAL_USER=user_localtest
# WICKER_LOCAL_USER_EMAIL=test@example.com

# Server-side AI. Hosted deployments must use an API provider (openai or
# anthropic); the CLI providers (codex, claude) only work on a desktop.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
# or
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Editorial pipeline: model per stage, overriding the provider default. Mapping
# and the quality audit reason over a whole course; drafting is schema-bound
# extraction from evidence already selected for it, is by far the most numerous
# call, and runs well on a small model.
# LLM_MAP_MODEL=gpt-5
# LLM_DRAFT_MODEL=gpt-5-mini
# LLM_QUALITY_MODEL=gpt-5

# Student AI allowances. Only grounded tutor chat, explicitly requested extra
# exercises, and reviewed academic-plan imports call the model. Token totals
# are persistent per Clerk user.
AI_CHAT_REQUESTS_PER_MINUTE=6
AI_CHAT_REQUESTS_PER_DAY=40
AI_CHAT_MAX_OUTPUT_TOKENS=2400
AI_EXERCISE_REQUESTS_PER_MINUTE=2
AI_EXERCISE_REQUESTS_PER_DAY=6
AI_EXERCISE_MAX_OUTPUT_TOKENS=8000
AI_INTAKE_REQUESTS_PER_MINUTE=2
AI_INTAKE_REQUESTS_PER_DAY=4
AI_INTAKE_MAX_OUTPUT_TOKENS=6000
AI_TOKENS_PER_DAY=120000
AI_TOKENS_PER_MONTH=1000000

# Optional editorial pipeline hook. `npm run content:ingest -- --ai` POSTs the
# validated, hashed catalog here for embeddings, enrichment, or CMS import.
AI_INGEST_ENDPOINT=
AI_INGEST_TOKEN=

# Eligibility. When set, only accounts whose primary email is on one of these
# domains (subdomains included) or listed verbatim in ALLOWED_EMAILS can enter
# the workspace; everyone else sees an "account not eligible" screen.
ALLOWED_EMAIL_DOMAINS=student.maastrichtuniversity.nl,maastrichtuniversity.nl
ALLOWED_EMAILS=
# Programme organisations: students are placed from the catalogue's
# institution.domains; see docs/AGENT_ACCESS.md ("Programmes and organisations").
