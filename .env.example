# Hosted persistence (Neon pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Authentication (Clerk dashboard → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Administrators: comma-separated Clerk user ids allowed to mint admin API keys
# and call /api/admin/* (editorial content, programme catalogue).
ADMIN_USER_IDS=user_...

# Server-side AI. Anthropic API is the production-safe provider supported by
# the existing tutor/generation code; CLI providers remain available locally.
LLM_PROVIDER=api
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Student AI allowances. Only grounded tutor chat, explicitly requested extra
# exercises, and reviewed academic-plan imports call the model. Token totals
# are persistent per Clerk user.
AI_CHAT_REQUESTS_PER_MINUTE=6
AI_CHAT_REQUESTS_PER_DAY=40
AI_CHAT_MAX_OUTPUT_TOKENS=2400
AI_EXERCISE_REQUESTS_PER_MINUTE=2
AI_EXERCISE_REQUESTS_PER_DAY=6
AI_EXERCISE_MAX_OUTPUT_TOKENS=8000
AI_INTAKE_REQUESTS_PER_MINUTE=2
AI_INTAKE_REQUESTS_PER_DAY=4
AI_INTAKE_MAX_OUTPUT_TOKENS=6000
AI_TOKENS_PER_DAY=120000
AI_TOKENS_PER_MONTH=1000000

# Optional editorial pipeline hook. `npm run content:ingest -- --ai` POSTs the
# validated, hashed catalog here for embeddings, enrichment, or CMS import.
AI_INGEST_ENDPOINT=
AI_INGEST_TOKEN=
