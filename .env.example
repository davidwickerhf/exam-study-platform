# Hosted persistence: any PostgreSQL 16+ with pgvector, via node-postgres.
# Plain postgres://user:pass@host:5432/db on a private network needs no TLS;
# add ?sslmode=require for a remote/managed database. Use a direct
# (non-PgBouncer) connection for the pg-boss worker.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Authentication: self-hosted Better Auth at /api/auth (README, Hosted sign-in).
# BETTER_AUTH_SECRET is required on the api and web services (openssl rand -base64 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4177
# Mail for verification, sign-in and reset codes (nodemailer URL). Unset in
# development prints codes to the console; unset in production refuses them.
# SMTP_URL=smtps://user:password@mail.example.com:465
# EMAIL_FROM=Wicker Study <noreply@study.wicker.life>
# Optional Google sign-in; redirect URI <origin>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Administrators: comma-separated user ids (auth_user.id) allowed to mint admin API keys
# and call /api/admin/* (editorial content, programme catalogue).
ADMIN_USER_IDS=user_...

# Local test user (development only). Runs the app against DATABASE_URL with no
# hosted sign-in, with every request acting as this user, so the database-backed
# admin and editorial surfaces can be exercised locally. Point DATABASE_URL at a
# database branch, never production. Refuses to start under NODE_ENV=production
# or alongside BETTER_AUTH_SECRET. See README "Local test user".
# WICKER_LOCAL_USER=user_localtest
# WICKER_LOCAL_USER_EMAIL=test@example.com

# Server-side AI. Hosted deployments must use an API provider (openai or
# anthropic); the CLI providers (codex, claude) only work on a desktop.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
# or
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Editorial pipeline: model per stage, overriding the provider default. Mapping
# and the quality audit reason over a whole course; drafting is schema-bound
# extraction from evidence already selected for it, is by far the most numerous
# call, and runs well on a small model.
# LLM_MAP_MODEL=gpt-5
# LLM_DRAFT_MODEL=gpt-5-mini
# LLM_QUALITY_MODEL=gpt-5

# Student AI allowances. Only grounded tutor chat, explicitly requested extra
# exercises, and reviewed academic-plan imports call the model. Token totals
# are persistent per user.
AI_CHAT_REQUESTS_PER_MINUTE=6
AI_CHAT_REQUESTS_PER_DAY=40
AI_CHAT_MAX_OUTPUT_TOKENS=2400
AI_EXERCISE_REQUESTS_PER_MINUTE=2
AI_EXERCISE_REQUESTS_PER_DAY=6
AI_EXERCISE_MAX_OUTPUT_TOKENS=8000
AI_INTAKE_REQUESTS_PER_MINUTE=2
AI_INTAKE_REQUESTS_PER_DAY=4
AI_INTAKE_MAX_OUTPUT_TOKENS=6000
AI_TOKENS_PER_DAY=120000
AI_TOKENS_PER_MONTH=1000000

# Optional editorial pipeline hook. `npm run content:ingest -- --ai` POSTs the
# validated, hashed catalog here for embeddings, enrichment, or CMS import.
AI_INGEST_ENDPOINT=
AI_INGEST_TOKEN=

# Eligibility. When set, only accounts whose primary email is on one of these
# domains (subdomains included) or listed verbatim in ALLOWED_EMAILS can enter
# the workspace; everyone else sees an "account not eligible" screen.
ALLOWED_EMAIL_DOMAINS=student.maastrichtuniversity.nl,maastrichtuniversity.nl
ALLOWED_EMAILS=
# Programme organisations: students are placed from the catalogue's
# institution.domains; see docs/AGENT_ACCESS.md ("Programmes and organisations").

# Canvas connections. Each account's Canvas Personal Access Token is stored
# AES-256-GCM encrypted at rest under this key, and is never returned to the
# browser or to an API key. Without it, connecting Canvas is refused — which
# also disables the Updates board and the Canvas entries on Calendar.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CANVAS_CONNECTION_ENCRYPTION_KEY=

# Student study generation: all limits are checked before each paid request.
STUDY_PLATFORM_DAILY_USD=10
STUDY_PLATFORM_MONTHLY_USD=100
STUDY_USER_DAILY_USD=0.5
STUDY_USER_MONTHLY_USD=3
STUDY_CHAPTERS_PER_DAY=6
STUDY_CHAPTERS_PER_MONTH=30
STUDY_REQUESTS_PER_MINUTE=4
STUDY_TOKENS_PER_DAY=300000
STUDY_PERSONAL_TOKENS_PER_DAY=2000000
STUDY_MAX_JOB_USD=1
# 32-byte base64 key for encrypted personal AI credentials. If empty, uses a
# domain-separated subkey of CANVAS_CONNECTION_ENCRYPTION_KEY when configured.
AI_CONNECTION_ENCRYPTION_KEY=

# Self-hosting (Coolify, see docker-compose.coolify.yml).
# WICKER_API_SERVICE_URL=http://api:8080      # web + worker -> API container; also a web build arg
# WICKER_QUEUE_BACKEND=pg-boss                # web, api, worker: background work goes through pg-boss
# WICKER_QUEUE_DISPATCHER_URL=http://web:3000 # api -> web dispatcher wake-up
# CRON_SECRET=                                # protects GET /internal/canvas-dispatch
# DATABASE_POOL_MAX=10
# WICKER_DISPATCH_CRON="* * * * *"            # worker sweep schedule; "off" to disable
