                "academicYear": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "first",
                    "resit",
                    "carry-over",
                    "other"
                  ]
                },
                "examDate": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "grade": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
