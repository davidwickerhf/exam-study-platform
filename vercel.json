{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "functions": {
        "app/internal/canvas-consume/route.ts": {
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "canvas-sync-v1",
              "maxConcurrency": 2
            }
          ]
        },
        "app/internal/study-consume/route.ts": {
          "experimentalTriggers": [
            {
              "type": "queue/v2beta",
              "topic": "study-generation-v1",
              "maxConcurrency": 1
            }
          ]
        }
      },
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "WICKER_API_SERVICE_URL"
        }
      ]
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Containerfile"
    }
  },
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/skills/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/internal/canvas-dispatch",
      "schedule": "* * * * *"
    }
  ]
}
