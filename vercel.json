{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Containerfile"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/skills/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "functions": {
    "app/internal/canvas-consume/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "canvas-sync-v1",
          "maxConcurrency": 2
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/internal/canvas-dispatch",
      "schedule": "* * * * *"
    }
  ]
}
